# Copy this file to ".env" and fill in your own values. Never commit ".env".
# Plain KEY=value, one per line: no quotes, no < > around the values.

AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# The name you gave the deployment in Azure (may differ from the model family)
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# The underlying model family, e.g. gpt-4o
AZURE_OPENAI_MODEL=gpt-4o
AZURE_OPENAI_API_VERSION=your-api-version

# Optional
# RATE_SLEEP_SEC=1.0
# MAX_DEBUG_ROUNDS=2
